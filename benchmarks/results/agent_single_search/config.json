{
  "experiment": {
    "name": "agent_single_search",
    "system": "agent",
    "policy": "single_search",
    "description": "Fixed baseline: one search_documents call, then writer (no RL)"
  },
  "config": {
    "environment": "development",
    "paths": {
      "data_dir": "data",
      "index_dir": "data/processed/index",
      "trajectories_dir": "data/trajectories",
      "runs_dir": "benchmarks/results",
      "cache_dir": "data/processed/cache",
      "trace_dir": "data/processed/traces",
      "upload_dir": "data/raw/uploads"
    },
    "chunking": {
      "chunk_size": 1000,
      "chunk_overlap": 150,
      "min_chunk_chars": 40
    },
    "embedding": {
      "provider": "sentence_transformers",
      "model_name": "BAAI/bge-small-en-v1.5",
      "query_prefix": "Represent this sentence for searching relevant passages: ",
      "batch_size": 32,
      "device": "auto",
      "hashing_dim": 512,
      "cache": true
    },
    "retrieval": {
      "mode": "hybrid",
      "vector_store": "faiss",
      "top_k": 5,
      "candidate_k": 30,
      "fusion": "rrf",
      "rrf_k": 60,
      "dense_weight": 0.5,
      "bm25_k1": 1.5,
      "bm25_b": 0.75,
      "query_rewrite": "none",
      "qdrant_url": null,
      "qdrant_path": "data/processed/qdrant",
      "qdrant_collection": "atlas_chunks"
    },
    "reranker": {
      "enabled": true,
      "provider": "cross_encoder",
      "model_name": "cross-encoder/ms-marco-MiniLM-L-6-v2",
      "device": "auto"
    },
    "llm": {
      "provider": "hf_local",
      "model": "Qwen/Qwen2.5-1.5B-Instruct",
      "base_url": null,
      "api_key_env": null,
      "temperature": 0.0,
      "max_new_tokens": 320,
      "device": "auto",
      "timeout_s": 180.0,
      "max_retries": 2,
      "adapter_path": null,
      "price_input_per_mtok": 0.0,
      "price_output_per_mtok": 0.0
    },
    "vlm": {
      "provider": "hf_local",
      "model": "HuggingFaceTB/SmolVLM-256M-Instruct",
      "base_url": null,
      "api_key_env": null,
      "max_new_tokens": 200,
      "device": "auto",
      "timeout_s": 120.0
    },
    "multimodal": {
      "extract_tables": true,
      "extract_figures": true,
      "describe_figures_at_ingest": false,
      "min_image_pixels": 22500
    },
    "agent": {
      "policy": "single_search",
      "learned_policy_path": "data/processed/rl/policy.pt",
      "max_iterations": 6,
      "max_tool_calls": 8,
      "timeout_s": 300.0,
      "critic": "heuristic",
      "min_evidence": 2,
      "sufficient_score": 0.6,
      "planner": "llm",
      "max_subquestions": 3
    },
    "tools": {
      "python_mode": "sandbox",
      "python_timeout_s": 5.0,
      "python_memory_mb": 256,
      "sql_db_path": "data/processed/index/tables.sqlite",
      "web_backend": "disabled",
      "web_max_results": 3,
      "web_timeout_s": 10.0,
      "tool_timeout_s": 120.0
    },
    "serving": {
      "host": "0.0.0.0",
      "port": 8000,
      "request_timeout_s": 300.0,
      "queue_backend": "memory",
      "redis_url": "redis://localhost:6379/0",
      "max_concurrent_jobs": 1,
      "max_upload_mb": 50,
      "rate_limit_per_minute": 60
    },
    "cache": {
      "backend": "memory",
      "ttl_s": 3600,
      "max_items": 2048
    },
    "observability": {
      "log_level": "INFO",
      "log_json": false,
      "tracing": true,
      "metrics": true
    },
    "trajectory": {
      "enabled": true,
      "filename": "trajectories.jsonl"
    }
  }
}