# Copy to .env (never commit .env). Atlas reads secrets from the environment only.
# --- optional hosted model providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=
HF_TOKEN=
# --- config overrides: ATLAS__<SECTION>__<KEY> ---
# Use a hosted Claude model instead of the local Qwen model:
# ATLAS__LLM__PROVIDER=anthropic
# ATLAS__LLM__MODEL=claude-haiku-4-5
# ATLAS__LLM__API_KEY_ENV=ANTHROPIC_API_KEY
# Use a vLLM server:
# ATLAS__LLM__PROVIDER=openai_compatible
# ATLAS__LLM__BASE_URL=http://localhost:8001/v1
# ATLAS__LLM__MODEL=Qwen/Qwen2.5-7B-Instruct
# Fully offline, no LLM (extractive baseline):
# ATLAS__LLM__PROVIDER=extractive
# Enable web search (no key needed for Wikipedia):
# ATLAS__TOOLS__WEB_BACKEND=wikipedia
# Distributed mode:
# ATLAS__SERVING__QUEUE_BACKEND=redis
# ATLAS__SERVING__REDIS_URL=redis://localhost:6379/0
